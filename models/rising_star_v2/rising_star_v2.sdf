<?xml version="1.0"?>
<sdf version="1.6">
  <model name="rising_star_v2">
    <!-- ====================================================================== -->
    <!-- DOCUMENTATION HEADER                                                    -->
    <!-- ====================================================================== -->
    <!--
      Rising Star v2 PX4 Gazebo Classic model.

      Current model features:
        - two large rotor blades
        - independent blade pitch variables
        - GP-76 engine visual placeholders
        - engine torque dynamics from engines at 3 ft radius
        - fixed barbell plate payload mass
        - tripod mast between base and rotor hub
        - no visible base box
        - 7 degree pre-cone on blades
        - 4 ft teeter beam with 12 ft blades
        - 28 ft nominal rotor diameter

      This is an intermediate engineering model.
      It is intended for simulation architecture, design iteration, and PX4
      integration work. It is not yet a full blade-element aerodynamic model.
    -->
    <pose>0 0 0.86 0 0 0</pose>
    <static>false</static>

    <!-- ====================================================================== -->
    <!-- base_link                                                              -->
    <!-- ====================================================================== -->
    <!--
      Non-rotating vehicle body reference.

      The visible base box has been removed to better match the actual design.
      This link still keeps inertial properties because Gazebo needs physical
      mass and inertia for the vehicle body.

      The tripod mast visuals are attached to this base_link.
    -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>11.05</mass>
        <inertia>
          <ixx>8.0</ixx>
          <iyy>8.0</iyy>
          <izz>12.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- ======================================================= -->
      <!-- Tripod mast between base_link and rotor hub              -->
      <!-- This is fixed to base_link and visually supports rotor   -->
      <!-- area. It does not physically attach to spinning rotor_link. -->
      <!-- ======================================================= -->
      <collision name="tripod_mast_front_left_collision">
        <pose>0.2250 0.1600 -0.1600 0.000000 0.390870 -2.523448</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>1.4493</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <collision name="tripod_mast_front_right_collision">
        <pose>0.2250 -0.1600 -0.1600 0.000000 0.390870 2.523448</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>1.4493</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <collision name="tripod_mast_rear_collision">
        <pose>-0.2400 0.0000 -0.1600 0.000000 0.343969 0.000000</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>1.4234</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>

      <visual name="tripod_mast_front_left_visual">
        <pose>0.2250 0.1600 -0.1600 0.000000 0.390870 -2.523448</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>1.4493</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <visual name="tripod_mast_front_right_visual">
        <pose>0.2250 -0.1600 -0.1600 0.000000 0.390870 2.523448</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>1.4493</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <visual name="tripod_mast_rear_visual">
        <pose>-0.2400 0.0000 -0.1600 0.000000 0.343969 0.000000</pose>
        <geometry>
          <cylinder>
            <radius>0.0250</radius>
            <length>1.4234</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
      <visual name="tripod_mast_top_joint_visual">
        <pose>0.0000 0.0000 0.5500 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.18 0.18 0.18 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>
      </visual>

      <visual name="tripod_mast_top_plate_visual">
        <pose>0 0 0.51 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.16 0.16 0.16 1</ambient>
          <diffuse>0.16 0.16 0.16 1</diffuse>
        </material>
      </visual>

      <!-- ================================================================== -->
      <!-- PX4 SITL sensor: IMU                                                -->
      <!-- ================================================================== -->
      <!--
        This sensor/plugin publishes IMU data for PX4 through the Gazebo
        mavlink_interface. The topic is /imu, matching imuSubTopic below.
      -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0003394</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>3.8785e-05</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0003394</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>3.8785e-05</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0003394</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>3.8785e-05</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.004</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.006</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.004</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.006</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.004</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>0.006</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

    </link>

    <link name="/imu_link">
      <pose>0 0 0.694 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="flight_controller_visual">
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 0.08 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.18 0.08 1</ambient>
          <diffuse>0.04 0.35 0.14 1</diffuse>
          <specular>0.05 0.12 0.05 1</specular>
        </material>
      </visual>
    </link>

    <joint name="/imu_joint" type="fixed">
      <child>/imu_link</child>
      <!-- Rotor-hub mounted flight controller for SITL. The IMU link spins
           with rotor_link; mavlink_interface de-rotates it back into the
           body frame before sending data to stock PX4. -->
      <parent>rotor_link</parent>
    </joint>

    <!-- ====================================================================== -->
    <!-- rotor_link                                                              -->
    <!-- ====================================================================== -->
    <!--
      Simplified spinning rotor assembly.

      Contains the spinning hub and GP-76 engine visual placeholders.
      The blade visuals/collisions live on teeter_beam_link so they follow
      the teeter hinge.
    -->
    <link name="rotor_link">
      <pose>0 0 0.694 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>18.0</ixx>
          <iyy>18.0</iyy>
          <izz>35.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Central rotor hub / teeter pivot housing. -->
      <collision name="rotor_hub_collision">
        <pose>0 0 -0.0889 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="rotor_hub_visual">
        <pose>0 0 -0.0889 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.20 0.20 1</ambient>
          <diffuse>0.20 0.20 0.20 1</diffuse>
        </material>
      </visual>

      <!-- Central teeter pivot marker.
           This is the lower center point of the V shape:
           right beam endpoint 1 =  0.0000 0 -0.0748494683
           left  beam endpoint 1 =  0.0000 0 -0.0748494683
      -->
      <visual name="teeter_center_pivot_visual">
        <pose>0 0 -0.0748494683 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.075</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.10 0.10 0.10 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

    </link>

    <!-- Physical teeter assembly.
         This link carries the blade visuals/collisions and rocks like a seesaw
         on a single hinge carried by the spinning rotor hub. -->
    <link name="teeter_beam_link">
      <pose>0 0 0.694 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>18.0</ixx>
          <iyy>18.0</iyy>
          <izz>35.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Left teeter beam: center pivot -> blade_2_visual root (+Y span) -->
      <collision name="teeter_beam_right_collision">
        <pose>0 0.3048 -0.0374247342 -1.448623279155 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.6141779896</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="teeter_beam_right_visual">
        <pose>0 0.3048 -0.0374247342 -1.448623279155 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.6141779896</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Right teeter beam: center pivot -> blade_1_visual root (-Y span) -->
      <collision name="teeter_beam_left_collision">
        <pose>0 -0.3048 -0.0374247342 1.448623279155 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.6141779896</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="teeter_beam_left_visual">
        <pose>0 -0.3048 -0.0374247342 1.448623279155 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.6141779896</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>

      <!-- Optional root clamps to make the blade connection obvious. -->
      <visual name="blade_1_root_clamp_visual">
        <pose>0 -0.6096 0.0000 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="blade_2_root_clamp_visual">
        <pose>0 0.6096 0.0000 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <visual name="tip_weight_1_visual">
        <pose>0 -4.2399368042 0.4457493104 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
      </visual>
      <visual name="tip_weight_2_visual">
        <pose>0 4.2399368042 0.4457493104 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
      </visual>

      <!-- Visible GP-76 engine placeholders at 3 ft radius.
           These live on teeter_beam_link so the engines follow the blade beam. -->
      <visual name="gp76_engine_1_body_visual">
        <pose>0.18 -0.9144 0.03 0 0 -1.57079632679</pose>
        <geometry>
          <box>
            <size>0.32 0.22 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="gp76_engine_1_cylinder_visual">
        <pose>0.18 -0.9144 0.20 1.57079632679 0 -1.57079632679</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
      <visual name="gp76_engine_1_prop_disc_visual">
        <pose>0.42 -0.9144 0.03 1.57079632679 0 -1.57079632679</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.9 0.45</ambient>
          <diffuse>0.1 0.1 0.9 0.45</diffuse>
        </material>
      </visual>

      <visual name="gp76_engine_2_body_visual">
        <pose>-0.18 0.9144 0.03 0 0 1.57079632679</pose>
        <geometry>
          <box>
            <size>0.32 0.22 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="gp76_engine_2_cylinder_visual">
        <pose>-0.18 0.9144 0.20 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
      <visual name="gp76_engine_2_prop_disc_visual">
        <pose>-0.42 0.9144 0.03 1.57079632679 0 1.57079632679</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.9 0.45</ambient>
          <diffuse>0.1 0.1 0.9 0.45</diffuse>
        </material>
      </visual>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
    </link>

    <!-- Blade pitch links.
         The plugin places these links from teeter_beam_link each update so
         visualInspectionBladePitchDeg and actuator pitch are visible on the
         actual colored blade geometry. These are visual-only because rotor
         lift is applied by the plugin; collisions here would inject contact
         forces while the plugin kinematically moves the links. -->
    <link name="blade_1_pitch_link">
      <pose>0 -2.4247684021 0.9168746552 0 -0.12217304764 -1.57079632679</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="blade_1_visual">
        <geometry>
          <box>
            <size>3.6576 0.2667 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.70 0.15 1</ambient>
          <diffuse>0.0 0.70 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="blade_2_pitch_link">
      <pose>0 2.4247684021 0.9168746552 0 -0.12217304764 1.57079632679</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <iyy>0.000001</iyy>
          <izz>0.000001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="blade_2_visual">
        <geometry>
          <box>
            <size>3.6576 0.2667 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.05 0.05 1</ambient>
          <diffuse>0.85 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ====================================================================== -->
    <!-- payload_link                                                            -->
    <!-- ====================================================================== -->
    <!--
      Configurable barbell plate payload.

      The payload is centered on the system z axis and placed 0.5 m below the
      rotor_link origin. rotor_link is at z = 0.694 m, so the payload center is
      at z = 0.194 m in model/base coordinates.

      Gazebo physics uses the inertial values in this link at spawn time. Keep
      the fixed joint below in SDF so the payload mass is present before the
      physics engine initializes the model.

      Geometry uses the provided 17.375 in OD and 10 in stack thickness. Inertia
      assumes a standard 1 in center hole:
        Izz = 1/2 m (Ro^2 + Ri^2)
        Ixx = Iyy = 1/12 m (3 (Ro^2 + Ri^2) + t^2)

      The collision is approximated as a solid cylinder; the annular hole is
      represented in inertia, not collision geometry.

      Code run
      Tools/simulation/gazebo-classic/sitl_gazebo-classic/scripts/set_rising_star_payload.py 360


    -->

    <link name="payload_link">
      <pose>0 0 0.194 0 0 0</pose>
      <inertial>
        <mass>0.5000000000</mass>
        <inertia>
          <ixx>0.00879482</ixx>
          <iyy>0.00879482</iyy>
          <izz>0.01221331</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="payload_plate_collision">
        <geometry>
          <cylinder>
            <radius>0.2206625</radius>
            <length>0.254</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode />
          </friction>
        </surface>
      </collision>
      <visual name="payload_plate_visual">
        <geometry>
          <cylinder>
            <radius>0.2206625</radius>
            <length>0.254</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.04 0.04 0.04 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>
    </link>

    <joint name="payload_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>payload_link</child>
    </joint>

    <joint name="main_rotor_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_link</child>
      <pose>0 0 0.694 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>10000</effort>
          <velocity>1000</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="teeter_hinge_joint" type="revolute">
      <parent>rotor_link</parent>
      <child>teeter_beam_link</child>
      <pose>0 0 0.694 0 0 0</pose>
      <axis>
        <!-- Blade span is along rotor local Y, so the seesaw hinge axis is X. -->
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.2617993878</lower>
          <upper>0.2617993878</upper>
          <effort>10000</effort>
          <velocity>3.14159265359</velocity>
        </limit>
        <dynamics>
          <damping>600.0</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin name="rising_star_plugin" filename="librising_star_plugin.so">
      <!-- baseLinkName:
           Name of the non-rotating vehicle body link. -->
      <baseLinkName>base_link</baseLinkName>
      <!-- rotorLinkName:
           Name of the simplified spinning rotor assembly. -->
      <rotorLinkName>rotor_link</rotorLinkName>
      <teeterBeamLinkName>teeter_beam_link</teeterBeamLinkName>
      <blade1PitchLinkName>blade_1_pitch_link</blade1PitchLinkName>
      <blade2PitchLinkName>blade_2_pitch_link</blade2PitchLinkName>
      <!-- payloadLinkName:
           Physical payload link. Its SDF inertial block is the payload physics. -->
      <payloadLinkName>payload_link</payloadLinkName>
      <!-- jointName:
           Revolute joint connecting base_link and rotor_link. -->
      <jointName>main_rotor_joint</jointName>
      <teeterHingeJointName>teeter_hinge_joint</teeterHingeJointName>

      <!-- Primary test variables -->
      <!-- targetRpm:
           If useEngineDynamics=false, this directly forces rotor RPM.
           If useEngineDynamics=true, this is only the initial RPM at spawn.
           Unit: rpm. -->
      <targetRpm>0.0</targetRpm>
      <!-- payloadEnabled:
           true = configure physical payload mass from payloadMassLb and show
           the payload visual.
           false = configure a stable 0.5 kg dummy payload and hide the visual. -->
      <payloadEnabled>true</payloadEnabled>
      <!-- payloadMassLb:
           Informational payload mass in pounds-mass for plugin prints and
           calculations. Gazebo physics comes from payload_link/inertial above;
           keep these values matched.

           Typical tests:
             0 lb   -> empty vehicle
             360 lb -> current barbell plate payload
             398 lb -> near 440 lb design gross
             420 lb -> 10:1 payload-to-empty target, likely overloaded -->
      <payloadMassLb>0.0</payloadMassLb>
      <!-- payloadOffsetFromCogM:
           Payload center location in model/base coordinates, measured from the
           current system CoG frame used by the simplified model. Current value
           places the plate 0.5 m below rotor_link origin:
             rotor z 0.694 m - 0.5 m = payload z 0.194 m. -->
      <payloadOffsetFromCogM>0 0 0.194</payloadOffsetFromCogM>
      <!-- Barbell plate dimensions used to calculate annular-cylinder inertia. -->
      <payloadOuterDiameterIn>17.375</payloadOuterDiameterIn>
      <payloadInnerDiameterIn>1.0</payloadInnerDiameterIn>
      <payloadThicknessIn>10.0</payloadThicknessIn>
      <!-- payloadDisabledScale:
           Used only for the disabled payload dummy inertia calculation.
           payloadEnabled=true intentionally ignores this value. -->
      <payloadDisabledScale>0.08</payloadDisabledScale>
      <!-- blade1PitchDeg:
           Pitch command for blade 1 in degrees.
           Design/reference value: 7.27 deg. -->
      <blade1PitchDeg>5.0</blade1PitchDeg>
      <!-- blade2PitchDeg:
           Pitch command for blade 2 in degrees.
           Equal blade1/blade2 pitch gives mostly symmetric lift.
           Different fixed pitch creates rotating imbalance, not true cyclic control. -->
      <blade2PitchDeg>5.0</blade2PitchDeg>

      <!-- ================================================================== -->
      <!-- Simple horizontal wind/body drag                                    -->
      <!-- ================================================================== -->
      <!-- enableHorizontalWindDrag:
           true = subscribe to the Gazebo wind topic and add simple horizontal
             quadratic drag on base_link and payload_link.
           This is intentionally a first-order SITL disturbance model. It does
           not yet model rotor disk inflow, advancing/retreating blade effects,
           or wind-induced flapping. -->
      <enableHorizontalWindDrag>true</enableHorizontalWindDrag>

      <!-- windSubTopic:
           Topic published by windy.world/ramped_up_wind.world through
           libgazebo_wind_plugin.so. With windy.world this is a steady
           4 m/s wind in the world +Y direction. -->
      <windSubTopic>world_wind</windSubTopic>

      <!-- Horizontal drag model:
             F_xy = -0.5 * rho * Cd * area * |Vair_xy| * Vair_xy
             Vair = link_velocity_world - wind_velocity_world

           These values represent the first real 4 m/s wind-load check rather
           than a reduced bring-up disturbance. At 4 m/s, the default total
           horizontal force is about 11.4 N. Tune area downward only when a
           gentler bring-up case is needed. -->
      <bodyHorizontalDragCoefficient>1.1</bodyHorizontalDragCoefficient>
      <bodyHorizontalDragAreaM2>0.9</bodyHorizontalDragAreaM2>
      <payloadHorizontalDragCoefficient>1.1</payloadHorizontalDragCoefficient>
      <payloadHorizontalDragAreaM2>0.16</payloadHorizontalDragAreaM2>

      <!-- Wind drag debug:
           Prints wind and applied body/payload force vectors to the Gazebo
           terminal. Keep this off unless tuning the force scale. -->
      <printWindDragDebug>false</printWindDragDebug>
      <windDragDebugIntervalSec>1.0</windDragDebugIntervalSec>

      <!-- ================================================================== -->
      <!-- Rotor imbalance disturbance                                         -->
      <!-- ================================================================== -->
      <!-- enableRotorImbalance:
           SITL-only rotating lateral force used to emulate rotor/engine/stand
           imbalance seen in fixed-stand hardware tests. It is disabled for
           nominal SITL behavior; enable it only for fixed-stand comparison.

           Force model:
             F_xy = forceAtReferenceRpm * (rpm / referenceRpm)^2
             direction rotates with the rotor azimuth plus phaseDeg

           Apply this to reproduce vibration/failure-detector behavior, not as
           an aerodynamic truth model. Start small and increase until
           failure_detector_status.imbalanced_prop_metric reaches the desired
           test range. -->
      <enableRotorImbalance>false</enableRotorImbalance>
      <!-- Force amplitude at rotorImbalanceReferenceRpm. Unit: N. -->
      <rotorImbalanceForceAtReferenceRpmN>5.0</rotorImbalanceForceAtReferenceRpmN>
      <!-- Reference RPM for the quadratic force scaling. -->
      <rotorImbalanceReferenceRpm>70.0</rotorImbalanceReferenceRpm>
      <!-- Phase offset of the imbalance force relative to plugin rotor azimuth. -->
      <rotorImbalancePhaseDeg>0.0</rotorImbalancePhaseDeg>
      <!-- Application point in base_link/model coordinates. The default is the
           main rotor hub height, so the lateral force also excites body moment. -->
      <rotorImbalanceApplicationPointM>0 0 0.694</rotorImbalanceApplicationPointM>
      <!-- Debug prints for applied imbalance force. -->
      <printRotorImbalanceDebug>false</printRotorImbalanceDebug>
      <rotorImbalanceDebugIntervalSec>1.0</rotorImbalanceDebugIntervalSec>

      <!-- ================================================================== -->
      <!-- Azimuth-based cyclic pitch                                          -->
      <!-- ================================================================== -->
      <!-- useCyclicPitch:
           false = use fixed blade1PitchDeg and blade2PitchDeg.
           true  = compute blade pitch from rotor azimuth every update.

           Cyclic pitch formula:
             blade_pitch = collectiveDeg
                         + rollCyclicDeg  * cos(azimuth + cyclicPhaseOffsetDeg)
                         - pitchCyclicDeg * sin(azimuth + cyclicPhaseOffsetDeg)

           Blade 2 is evaluated 180 degrees away from blade 1.
      -->
      <useCyclicPitch>false</useCyclicPitch>

      <!-- collectiveDeg:
           Mean blade pitch for both blades.
           This replaces fixed blade pitch when useCyclicPitch=true.
           Current SITL gross weight is about 402 lb, so the expected hover
           collective is about 6.73 deg with the 440 lb @ 7.27 deg design
           lift model. PX4 actuator input overrides this fallback value. -->
      <collectiveDeg>6.73</collectiveDeg>

      <!-- rollCyclicDeg:
           Cyclic pitch amplitude used to create roll control moment.
           Start very small: 0.0 to 1.0 deg.
           Sign/phase may need tuning after observing Gazebo response. -->
      <rollCyclicDeg>0.0</rollCyclicDeg>

      <!-- pitchCyclicDeg:
           Cyclic pitch amplitude used to create pitch control moment.
           Start very small: 0.0 to 1.0 deg.
           Sign/phase may need tuning after observing Gazebo response. -->
      <pitchCyclicDeg>0.0</pitchCyclicDeg>

      <!-- cyclicPhaseOffsetDeg:
           Phase tuning knob.
           Helicopter/rotor systems often need phase correction.
           Start at 0 deg, then tune sign and phase after observing response. -->
      <cyclicPhaseOffsetDeg>0.0</cyclicPhaseOffsetDeg>

      <!-- cyclicAzimuthSource:
           joint/as5600 = compute cyclic pitch from the current main rotor
             joint angle, equivalent to using a blade azimuth sensor.
           integrated = use the plugin's internally integrated rotor angle.

           Use joint/as5600 for the hardware-like path: the blade pitch command
           is scheduled from the measured blade azimuth instead of only elapsed
           time and commanded RPM. -->
      <cyclicAzimuthSource>as5600</cyclicAzimuthSource>
      <!-- cyclicAzimuthZeroOffsetRad:
           AS5600-style zero offset. In the hardware-like Y-span geometry,
           blade 1 is on rotor local -Y / body right at AS5600 zero, so
           rising_star_control adds a +90 deg blade azimuth offset. -->
      <cyclicAzimuthZeroOffsetRad>0.0</cyclicAzimuthZeroOffsetRad>
      <!-- cyclicAzimuthDirection:
           Set to -1 if the sensor angle increases opposite the rotor model's
           positive azimuth direction. -->
      <cyclicAzimuthDirection>1</cyclicAzimuthDirection>

      <!-- Fast cyclic bring-up knobs.
           Use these to verify compass/GPS-frame N/E/S/W response without
           recompiling the plugin:
             cyclicCommandFrame=world: treat cyclic channels as world XY and
               rotate them into the current body frame before blade phasing.
             cyclicCommandFrame=body: treat cyclic channels as body-frame.
             swapCyclicInputs: exchange PX4 roll and pitch cyclic channels.
             rollCyclicSign / pitchCyclicSign: set to -1.0 to invert one axis.
           Leave these at default first, then tune only if Gazebo motion is
           90 deg rotated, mirrored, or diagonal-biased. -->
      <cyclicCommandFrame>world</cyclicCommandFrame>
      <swapCyclicInputs>false</swapCyclicInputs>
      <rollCyclicSign>1.0</rollCyclicSign>
      <pitchCyclicSign>1.0</pitchCyclicSign>

      <!-- ================================================================== -->
      <!-- Teeter dynamics                                                     -->
      <!-- ================================================================== -->
      <!-- enableTeeterDynamics:
           true = integrate a simplified teeter/flapping angle in the plugin.
           Blade lift imbalance creates a moment about the rotor local X axis,
           beta is clamped by teeterAngleLimitDeg, and blade forces are applied
           in the tilted disk frame. This is an intermediate model before
           adding a full SDF teeter hinge/link stack. -->
      <enableTeeterDynamics>true</enableTeeterDynamics>
      <!-- teeterInertiaKgm2:
           Effective inertia about the teeter hinge. Higher values slow teeter
           response; lower values make cyclic response sharper. -->
      <teeterInertiaKgm2>80.0</teeterInertiaKgm2>
      <!-- teeterDampingNmPerRadS:
           Hinge/flapping damping. Increase if teeter angle chatters or hits
           the +/- limit too aggressively. -->
      <teeterDampingNmPerRadS>600.0</teeterDampingNmPerRadS>
      <!-- teeterStiffnessNmPerRad:
           Optional centering stiffness. Real teeter hinges are close to free,
           so keep this at zero for first bring-up. -->
      <teeterStiffnessNmPerRad>0.0</teeterStiffnessNmPerRad>
      <!-- teeterMomentSign:
           Set to -1.0 if cyclic response is mirrored after enabling teeter
           dynamics. -->
      <teeterMomentSign>1.0</teeterMomentSign>
      <teeterRateLimitDegS>180.0</teeterRateLimitDegS>

      <!-- ================================================================== -->
      <!-- PX4 actuator bridge                                                 -->
      <!-- ================================================================== -->
      <!-- enablePx4ActuatorInput:
           true  = subscribe to PX4/Gazebo motor speed command topic.
           false = use only SDF/manual values.

           This is the first PX4 integration step.
      -->
      <enablePx4ActuatorInput>true</enablePx4ActuatorInput>

      <!-- px4ActuatorTopic:
           Gazebo transport topic published by PX4 SITL mavlink_interface.

           In many PX4 v1.13 Gazebo Classic setups, this topic is:
             ~/command/motor_speed

           The plugin subscribes using Gazebo transport.
      -->
      <px4ActuatorTopic>~/rising_star_v2/gazebo/command/motor_speed</px4ActuatorTopic>

      <!-- px4InputMode:
           motor_speed = subscribe to mav_msgs::msgs::CommandMotorSpeed.

           With px4PitchInputMode=blade_pitch, the channel mapping follows the
           real Pixhawk wiring:
             actuator[0] -> engine throttle A
             actuator[1] -> engine throttle B
             actuator[2] -> blade 1 pitch servo
             actuator[3] -> blade 2 pitch servo
      -->
      <px4InputMode>motor_speed</px4InputMode>
      <px4PitchInputMode>blade_pitch</px4PitchInputMode>

      <!-- px4MotorSpeedScale:
           Normalization divisor for motor_speed values.

           PX4 motor speed outputs in Gazebo are often not pure 0..1.
           For initial testing, this bridge normalizes each actuator as:
             normalized = clamp(motor_speed / px4MotorSpeedScale, 0, 1)

           If PX4 outputs are already 0..1, set this to 1.0.
           If PX4 outputs are around 0..1000, use 1000.
           If outputs are rad/s-like, tune this value. -->
      <px4MotorSpeedScale>1000.0</px4MotorSpeedScale>

      <!-- Throttle raw mapping:
           In HITL, pwm_out_sim publishes normalized actuator_outputs_sim and
           gazebo_mavlink_interface scales them by input_scaling=1000 below.
           Treat 0 as zero command and 1000 as full command. -->
      <px4ThrottleZeroRaw>0.0</px4ThrottleZeroRaw>
      <px4ThrottleFullRaw>1000.0</px4ThrottleFullRaw>
      <px4CollectiveZeroRaw>0.0</px4CollectiveZeroRaw>
      <px4CollectiveFullRaw>1000.0</px4CollectiveFullRaw>

      <!-- px4CommandTimeoutSec:
           If no PX4 actuator message is received for this many seconds,
           plugin falls back to SDF/manual command values. -->
      <px4CommandTimeoutSec>0.5</px4CommandTimeoutSec>

      <!-- PX4 input debug:
           Prints raw motor_speed, normalized values, and mapped command values
           to the Gazebo terminal so QGC stick inputs can be inspected live. -->
      <printPx4InputDebug>false</printPx4InputDebug>
      <px4InputDebugIntervalSec>0.2</px4InputDebugIntervalSec>
      <!-- Teeter state debug:
           Prints RPM, blade pitch, teeter angle/rate, and lift to
           the Gazebo terminal. -->
      <printTeeterStateDebug>false</printTeeterStateDebug>
      <teeterStateDebugIntervalSec>1.0</teeterStateDebugIntervalSec>

      <!-- Engine dynamics -->
      <!-- useEngineDynamics:
           true  = compute rotor RPM from engine torque and drag torque.
           false = force rotor RPM using targetRpm.

           Use false for debugging lift at a known RPM.
           Use true for spin-up and engine behavior tests. -->
      <useEngineDynamics>true</useEngineDynamics>
      <!-- engineThrottle:
           Normalized throttle for both GP-76 engines.
           Range: 0.0 to 1.0.
           With PX4 actuator input enabled this is only a manual fallback.
           Keep it at zero so the rotor stays stopped until PX4 commands arrive. -->
      <engineThrottle>0.0</engineThrottle>
      <!-- engineRadiusFt:
           Distance from rotor center to each engine thrust line.
           Given design value: 3 ft.
           This is the torque arm for engine thrust. -->
      <engineRadiusFt>3.0</engineRadiusFt>
      <!-- engineThrustLbEach:
           Maximum thrust from each GP-76 engine/prop unit.
           Given design value: 54 lbf each.

           Full throttle drive torque:
             2 engines * 54 lbf * 3 ft = 324 ft-lb ≈ 439 N*m

           The plugin also caps drive torque by available rotor power from
           equivalentShaftHp * propulsiveEfficiency. With 16 hp and 0.85
           efficiency this is about 10.1 kW, or about 440 N*m at 220 rpm. -->
      <engineThrustLbEach>54.0</engineThrustLbEach>
      <!-- Step 1/2 tuning: increase rotorInertiaKgm2 for slower spool-up, decrease for faster
      spool-up. -->
      <!-- rotorInertiaKgm2:
           Effective rotational inertia of the rotor system.
           Larger value = slower RPM spool-up.
           Smaller value = faster RPM spool-up.
           The existing 45 kg*m^2 tuning value is retained after the blade
           repair. Replace it after the repaired rotor mass, CG, and complete
           SolidWorks rotor inertia are measured. -->
      <rotorInertiaKgm2>45.0</rotorInertiaKgm2>
      <!-- kTorque:
           Rotor drag torque coefficient.

           Model:
             drag_torque = kTorque * omega^2

           Derived from:
             325 ft-lb = 440.6 N*m
             220 rpm = 23.038 rad/s
             kTorque = 440.6 / 23.038^2 ≈ 0.831 -->
      <kTorque>0.831</kTorque>

      <!-- Visual inspection mode:
           true = ignore PX4 actuator input and hold the commanded inspection
             blade pitch, rotor azimuth, and teeter angle for Gazebo viewing.
           Set this back to false before flight-control tests. -->
      <visualInspectionMode>false</visualInspectionMode>
      <visualInspectionBladePitchDeg>20.0</visualInspectionBladePitchDeg>
      <visualInspectionRotorAzimuthDeg>0.0</visualInspectionRotorAzimuthDeg>
      <visualInspectionTeeterDeg>0.0</visualInspectionTeeterDeg>
      <!-- true = use the visual-only blade pitch links during flight so the
           colored blades show the commanded pitch angle. These links have no
           collision, and rotor lift is still applied by the plugin. -->
      <updateBladePitchVisualsDuringFlight>true</updateBladePitchVisualsDuringFlight>

      <!-- Fixed constants -->
      <!-- emptyWeightLb:
           Target empty vehicle weight.
           Given design value: 42 lb.
           Current SDF inertial masses approximate this empty weight. -->
      <emptyWeightLb>42.0</emptyWeightLb>
      <!-- kThrust:
           Equivalent rotor lift coefficient.

           Model:
             lift = kThrust * omega^2 * pitch_factor

           Current value makes about 440 lbf at 220 rpm and 7.27 deg pitch.
           With the current physical SDF mass of about 402 lb, expected hover
           is about 6.73 deg collective at 220 rpm.
           Unit: N/(rad/s)^2. -->
      <kThrust>3.69</kThrust>
      <!-- maxRpm:
           Maximum rotor RPM.
           Given design value: 220 rpm.
           Engine dynamics clamp rotor speed to this value. -->
      <maxRpm>220.0</maxRpm>

      <!-- Pitch model -->
      <!-- hoverPitchDeg:
           Reference pitch where pitch_factor = 1.0.
           Given design condition: 440 lb at 7.27 deg. -->
      <hoverPitchDeg>7.27</hoverPitchDeg>
      <!-- zeroLiftPitchDeg:
           Simple linear model zero-lift reference pitch.
           Tuning parameter, not exact airfoil zero-lift angle. -->
      <zeroLiftPitchDeg>1.0</zeroLiftPitchDeg>
      <!-- minPitchDeg:
           Lower blade pitch clamp. This must be wider than the collective
           range because cyclic is added around collective. With collective
           near 9 deg and +/-12 deg cyclic, blade pitch can briefly go below
           zero on one side of the disk. -->
      <minPitchDeg>-4.0</minPitchDeg>
      <!-- maxPitchDeg:
           Upper blade pitch clamp. Keep this above the collective upper bound
           so cyclic authority is not clipped during lateral control. -->
      <maxPitchDeg>22.0</maxPitchDeg>

      <!-- Blade-element-lite lift model:
           Uses rotor radius, hub radius, blade chord, linear twist, air density,
           and a simple lift slope to estimate each blade's vertical lift by
           spanwise integration. This still omits induced inflow and drag, so
           bladeElementLiftScale is auto-calibrated when set to 0.0:

             scale = designGrossWeight / unscaled_lift_at(maxRpm, hoverPitchDeg)

           The scale is recomputed at startup from the current rotor and blade
           dimensions, preserving the 440 lbf design condition at 220 rpm and
           7.27 deg. -->
      <useBladeElementLift>true</useBladeElementLift>
      <airDensityKgM3>1.225</airDensityKgM3>
      <bladeLiftSlopePerRad>6.28318530718</bladeLiftSlopePerRad>
      <bladeElementSections>12</bladeElementSections>
      <bladeElementLiftScale>0.0</bladeElementLiftScale>

      <!-- Keep collective in charge of total rotor lift while cyclic pitch
           redistributes non-negative lift between the two blades. This avoids
           the legacy CL=0 clipping artifact where large cyclic increased total
           lift. The realized mean after blade-pitch clamps is retained, so
           actuator saturation can still change collective. -->
      <preserveCyclicMeanLift>true</preserveCyclicMeanLift>

      <!-- Rotor metadata -->
      <!-- rotorRadiusFt:
           Nominal rotor radius from center to blade tip:
             2 ft beam half-span + 12 ft blade = 14 ft.
           The nominal rotor diameter is therefore 28 ft. -->
      <rotorRadiusFt>14.0</rotorRadiusFt>
      <!-- hubRadiusFt:
           Teeter-beam half-span / blade start radius.
           The v2 beam is 4 ft root-to-root, so this is 2 ft. -->
      <hubRadiusFt>2.0</hubRadiusFt>
      <!-- numBlades:
           Number of large rotor blades. -->
      <numBlades>2</numBlades>
      <!-- bladeChordIn:
           Blade chord.
           Given value: 10.5 inches. -->
      <bladeChordIn>10.5</bladeChordIn>
      <!-- airfoil:
           Airfoil metadata.
           Not used yet in current equivalent lift model.
           Future blade-element model should use this. -->
      <airfoil>NACA23015</airfoil>
      <!-- tipSpeedFps:
           Tip speed at 220 rpm.
           A 14 ft radius gives approximately 322.5 ft/s. -->
      <tipSpeedFps>322.5</tipSpeedFps>
      <!-- designGrossWeightLb:
           Design gross weight at 7.27 deg collective.
           Given value: 440 lb. -->
      <designGrossWeightLb>440.0</designGrossWeightLb>
      <!-- tipWeightLb:
           Tip weight per blade.
           Given value: 2.53 lb. -->
      <tipWeightLb>2.53</tipWeightLb>
      <!-- bladeSpanwiseDensityLbFt:
           Approximate blade spanwise density.
           Given value: about 0.3 lb/ft. -->
      <bladeSpanwiseDensityLbFt>0.3</bladeSpanwiseDensityLbFt>
      <!-- forwardSpeedMph:
           Design forward speed metadata.
           Not used yet in current force model. -->
      <forwardSpeedMph>20.0</forwardSpeedMph>
      <!-- rotorTwistDeg:
           Blade twist metadata.
           Given value: 6 deg linear twist.
           Future blade-element model should use this. -->
      <rotorTwistDeg>6.0</rotorTwistDeg>
      <!-- rotorPlaneHeightFt:
           Rotor plane height above ground.
           Given value: 5 ft = 1.524 m. -->
      <rotorPlaneHeightFt>5.0</rotorPlaneHeightFt>
      <!-- teeterAngleLimitDeg:
           Physical teeter hinge range: +/- 15 deg. The SDF revolute-joint
           limits above use the same value in radians. -->
      <teeterAngleLimitDeg>15.0</teeterAngleLimitDeg>
      <!-- preConeAngleDeg:
           Blade pre-cone angle.
           Rising Star v2 value: 7 deg.

           Implemented:
             blade visual/collision tilted upward
             tip weights raised
             blade force application points include pre-cone offset -->
      <preConeAngleDeg>7.0</preConeAngleDeg>
      <!-- gyroPrecessionTorqueFtLb:
           Gyroscopic precession torque metadata.
           Not directly used yet. -->
      <gyroPrecessionTorqueFtLb>262.0</gyroPrecessionTorqueFtLb>
      <!-- torqueRequiredFtLb:
           Rotor torque required at design condition.
           Used to justify kTorque. -->
      <torqueRequiredFtLb>325.0</torqueRequiredFtLb>
      <!-- equivalentShaftHp:
           Equivalent shaft horsepower metadata.
           Given value: 16 hp. Used with propulsiveEfficiency as the engine
           power cap for rotor drive torque. -->
      <equivalentShaftHp>16.0</equivalentShaftHp>
      <!-- propulsiveEfficiency:
           Design assumption used to convert equivalentShaftHp into available
           rotor power. -->
      <propulsiveEfficiency>0.85</propulsiveEfficiency>
      <!-- numEngines:
           Number of GP-76 engines. -->
      <numEngines>2</numEngines>
      <!-- engineHpEach:
           GP-76 power metadata.
           Current torque model uses thrust and radius, not HP curve. -->
      <engineHpEach>8.0</engineHpEach>
      <!-- mainBladeSparOdMm:
           Main blade spar outer diameter metadata. -->
      <mainBladeSparOdMm>30.0</mainBladeSparOdMm>
      <!-- mainBladeSparIdMm:
           Main blade spar inner diameter metadata. -->
      <mainBladeSparIdMm>28.0</mainBladeSparIdMm>
    </plugin>

    <include>
      <uri>model://rising_star_gps</uri>
      <!-- Teeter-motion GPS experiment:
           attach the GPS to teeter_beam_link 0.20 m above the hinge center.
           At +/-15 deg teeter this creates about +/-5.2 cm lateral motion.
           rising_star_gps publishes this link pose instead of root model pose. -->
      <pose>0 0 0.894 0 0 0</pose>
      <name>gps0</name>
    </include>
    <joint name="gps0_joint" type="fixed">
      <child>gps0::link</child>
      <parent>teeter_beam_link</parent>
    </joint>

    <plugin name="groundtruth_plugin" filename="libgazebo_groundtruth_plugin.so">
      <robotNamespace />
    </plugin>
    <plugin name="magnetometer_plugin" filename="libgazebo_magnetometer_plugin.so">
      <robotNamespace />
      <pubRate>100</pubRate>
      <noiseDensity>0.0004</noiseDensity>
      <randomWalk>6.4e-06</randomWalk>
      <biasCorrelationTime>600</biasCorrelationTime>
      <magTopic>/mag</magTopic>
      <linkName>/imu_link</linkName>
    </plugin>
    <plugin name="barometer_plugin" filename="libgazebo_barometer_plugin.so">
      <robotNamespace />
      <pubRate>50</pubRate>
      <baroTopic>/baro</baroTopic>
      <baroDriftPaPerSec>0</baroDriftPaPerSec>
    </plugin>
    <plugin name="mavlink_interface" filename="libgazebo_mavlink_interface.so">
      <robotNamespace />
      <imuSubTopic>/imu</imuSubTopic>
      <magSubTopic>/mag</magSubTopic>
      <baroSubTopic>/baro</baroSubTopic>
      <mavlink_addr>INADDR_ANY</mavlink_addr>
      <mavlink_tcp_port>4560</mavlink_tcp_port>
      <mavlink_udp_port>14560</mavlink_udp_port>
      <serialEnabled>0</serialEnabled>
      <serialDevice>/dev/ttyACM0</serialDevice>
      <baudRate>921600</baudRate>
      <qgc_addr>INADDR_ANY</qgc_addr>
      <qgc_udp_port>14550</qgc_udp_port>
      <sdk_addr>INADDR_ANY</sdk_addr>
      <sdk_udp_port>14540</sdk_udp_port>
      <hil_mode>0</hil_mode>
      <hil_state_level>0</hil_state_level>
      <send_vision_estimation>0</send_vision_estimation>
      <send_odometry>1</send_odometry>
      <enable_lockstep>1</enable_lockstep>
      <!-- Hardware-like path: forward rotating-frame IMU data to PX4, publish
           fake AS5600, and let PX4's VehicleIMU/VehicleMagnetometer derotate
           the sensor streams with the same rotor_encoder source. -->
      <derotateImuToBaseLink>false</derotateImuToBaseLink>
      <derotateImuBaseLinkName>base_link</derotateImuBaseLinkName>
      <derotateImuSensorLinkName>/imu_link</derotateImuSensorLinkName>
      <derotateImuUseFakeAs5600>false</derotateImuUseFakeAs5600>
      <publishFakeAs5600>true</publishFakeAs5600>
      <fakeAs5600ZeroOffsetRad>0.0</fakeAs5600ZeroOffsetRad>
      <fakeAs5600Direction>1</fakeAs5600Direction>
      <fakeAs5600RateLpfHz>30.0</fakeAs5600RateLpfHz>
      <!-- Feed PX4 rotor_encoder at the same 200 Hz used by the hardware
           AS5600 path. Despite the legacy tag name, this interval controls the
           control-grade fake encoder publication, not only ULog diagnostics. -->
      <fakeAs5600UlogIntervalSec>0.005</fakeAs5600UlogIntervalSec>
      <use_tcp>1</use_tcp>
      <motorSpeedCommandPubTopic>/gazebo/command/motor_speed</motorSpeedCommandPubTopic>
      <control_channels>
        <channel name="engine_throttle">
          <input_index>0</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1000</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
        </channel>
        <channel name="engine_throttle_b">
          <input_index>1</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1000</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
        </channel>
        <channel name="blade_1_pitch_servo">
          <input_index>2</input_index>
          <input_offset>1</input_offset>
          <input_scaling>500</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
        </channel>
        <channel name="blade_2_pitch_servo">
          <input_index>3</input_index>
          <input_offset>1</input_offset>
          <input_scaling>500</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
        </channel>
      </control_channels>
    </plugin>
    <plugin name="rotors_gazebo_imu_plugin" filename="libgazebo_imu_plugin.so">
      <robotNamespace />
      <linkName>/imu_link</linkName>
      <imuTopic>/imu</imuTopic>
      <!-- SITL-only engine/prop IMU harmonics. This is gated by PX4 engine
           output so preflight and arming see the nominal IMU. This setting is
           a stress-test vibration profile, with the main horizontal peak moved
           near the 52 Hz component seen in log_128. A smooth 12 s envelope
           moves the amplitude between about 0.9x and 1.1x. This is intended
           to push the PX4 vibration metric toward 100, not for nominal SITL
           behavior. No burst term is used here. -->
      <enableEngineImuVibration>false</enableEngineImuVibration>
      <engineImuVibrationGateByMotorCommand>true</engineImuVibrationGateByMotorCommand>
      <engineImuVibrationMotorCommandTopic>~/rising_star_v2/gazebo/command/motor_speed</engineImuVibrationMotorCommandTopic>
      <engineImuVibrationMotorSpeedScale>1000.0</engineImuVibrationMotorSpeedScale>
      <engineImuVibrationMotorThreshold>0.05</engineImuVibrationMotorThreshold>
      <engineImuVibrationCommandTimeoutSec>0.5</engineImuVibrationCommandTimeoutSec>
      <engineImuVibrationStartSec>3.0</engineImuVibrationStartSec>
      <engineImuVibrationRampSec>2.0</engineImuVibrationRampSec>
      <engineImuVibrationEnvelopeAmplitude>0.1</engineImuVibrationEnvelopeAmplitude>
      <engineImuVibrationEnvelopePeriodSec>12.0</engineImuVibrationEnvelopePeriodSec>
      <engineImuVibrationEnvelopePhaseDeg>0.0</engineImuVibrationEnvelopePhaseDeg>
      <engineImuVibrationFreq1Hz>52.0</engineImuVibrationFreq1Hz>
      <engineImuVibrationFreq2Hz>69.0</engineImuVibrationFreq2Hz>
      <engineImuVibrationFreq3Hz>0.0</engineImuVibrationFreq3Hz>
      <engineImuVibrationFreq4Hz>0.0</engineImuVibrationFreq4Hz>
      <engineImuVibrationAccelAmp1Mps2>110 110 14</engineImuVibrationAccelAmp1Mps2>
      <engineImuVibrationAccelAmp2Mps2>90 90 14</engineImuVibrationAccelAmp2Mps2>
      <engineImuVibrationAccelAmp3Mps2>0 0 0</engineImuVibrationAccelAmp3Mps2>
      <engineImuVibrationAccelAmp4Mps2>0 0 0</engineImuVibrationAccelAmp4Mps2>
      <engineImuVibrationGyroAmp1Radps>0.30 0.30 0.04</engineImuVibrationGyroAmp1Radps>
      <engineImuVibrationGyroAmp2Radps>0.25 0.25 0.05</engineImuVibrationGyroAmp2Radps>
      <engineImuVibrationGyroAmp3Radps>0.00 0.00 0.00</engineImuVibrationGyroAmp3Radps>
      <engineImuVibrationGyroAmp4Radps>0.00 0.00 0.00</engineImuVibrationGyroAmp4Radps>
      <engineImuVibrationAccelPhase1Deg>0.0 90.0 0.0</engineImuVibrationAccelPhase1Deg>
      <engineImuVibrationAccelPhase2Deg>45.0 135.0 90.0</engineImuVibrationAccelPhase2Deg>
      <engineImuVibrationAccelPhase3Deg>0.0 0.0 0.0</engineImuVibrationAccelPhase3Deg>
      <engineImuVibrationAccelPhase4Deg>0.0 0.0 0.0</engineImuVibrationAccelPhase4Deg>
      <engineImuVibrationGyroPhase1Deg>0.0 90.0 0.0</engineImuVibrationGyroPhase1Deg>
      <engineImuVibrationGyroPhase2Deg>45.0 135.0 90.0</engineImuVibrationGyroPhase2Deg>
      <engineImuVibrationGyroPhase3Deg>0.0 0.0 0.0</engineImuVibrationGyroPhase3Deg>
      <engineImuVibrationGyroPhase4Deg>0.0 0.0 0.0</engineImuVibrationGyroPhase4Deg>
      <gyroscopeNoiseDensity>0.00018665</gyroscopeNoiseDensity>
      <gyroscopeRandomWalk>3.8785e-05</gyroscopeRandomWalk>
      <gyroscopeBiasCorrelationTime>1000.0</gyroscopeBiasCorrelationTime>
      <gyroscopeTurnOnBiasSigma>0.0087</gyroscopeTurnOnBiasSigma>
      <accelerometerNoiseDensity>0.00186</accelerometerNoiseDensity>
      <accelerometerRandomWalk>0.006</accelerometerRandomWalk>
      <accelerometerBiasCorrelationTime>300.0</accelerometerBiasCorrelationTime>
      <accelerometerTurnOnBiasSigma>0.196</accelerometerTurnOnBiasSigma>
    </plugin>

  </model>

</sdf>
